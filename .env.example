# ก๊อปเป็น .env แล้วเติมค่า -- ห้าม commit .env
# บน Windows สั่ง:  $env:VERIFY_TOKEN="..."; node server.js
# บน VPS ใช้ pm2:   pm2 start server.js --name chatlog

# ตั้งเอง อะไรก็ได้ ต้องใส่ค่าเดียวกันตอนผูก webhook ใน App Dashboard
VERIFY_TOKEN=osuka-2026

# App settings -> Basic -> App Secret  (ใช้ตรวจว่า request มาจาก Meta จริง)
APP_SECRET=

# ตั้งเอง -- โทเคนให้ mixhub ดึงข้อมูลผ่าน /export (สุ่มยาว ๆ)
EXPORT_TOKEN=

PORT=3000
DB_PATH=chatlog.db
